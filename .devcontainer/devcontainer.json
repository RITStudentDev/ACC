{
    "name": "ACC-Dev-Container",

    "build": {
        "dockerfile": "Dockerfile"
    },

    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

    "customizations": {
        "vscode": {
            "settings": {},

            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ]
        }
    },
    "privileged": true,
    "mounts": [
        "source=acc-docker-data,target=/var/lib/docker,type=volume"
    ],
    "postStartCommand": "sudo sh -c 'nohup dockerd > /var/log/dockerd.log 2>&1 &'",

    "postCreateCommand": "git --version && gcc --version && docker --version"
}